# Salin ke .env lalu isi nilainya. Urutan prioritas: env proses > .env > default.
# Semua variabel opsional kecuali ST_KEY.

# ST_KEY — bearer token gateway LLM (rahasia; tidak ada default, wajib diisi).
ST_KEY=sk-ganti-dengan-api-key-gateway

# ST_GW — endpoint gateway LLM. Default: http://localhost:20128/v1
#ST_GW=http://localhost:20128/v1

# ST_ES — Elasticsearch endpoint pencarian kitab. Default: http://localhost:9200/konten_kitab/_search
#ST_ES=http://localhost:9200/konten_kitab/_search

# ST_DB — path SQLite request store. Default: ~/.local/share/semantic-turath/requests.db
#ST_DB=/home/kasjful-kurniawan/.local/share/semantic-turath/requests.db

# ST_WORKERS — jumlah worker pipeline (default 1; pipeline berat, jangan dinaikkan tanpa alasan).
#ST_WORKERS=1

# ST_TURATH_MCP — perintah server MCP Turath (stdio). Default: npx --yes tsx /home/kasjful-kurniawan/turath-mcp/src/index.ts
#ST_TURATH_MCP=npx --yes tsx /home/kasjful-kurniawan/turath-mcp/src/index.ts

# PORT — port HTTP server bila --serve tidak diberikan (dipakai pm2). Tidak ada default.
#PORT=20052
